{
    "name": "tcc/sistema-escolar",
    "description": "Sistema escolar em PHP com testes PHPUnit.",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.3.36 <8.4 || >=8.4.27 <8.5 || >=8.5.12 <8.6",
        "php-64bit": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "ext-xml": "*",
        "ext-xmlwriter": "*",
        "dompdf/dompdf": "^3.1.6",
        "phpmailer/phpmailer": "^7.0",
        "smalot/pdfparser": "^2.13.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "runtime-check": "@php bin/runtime-check.php",
        "validate-project": "@composer validate --strict",
        "lint": "@php bin/lint.php",
        "analyse": "@php vendor/phpstan/phpstan/phpstan.phar analyse --memory-limit=1G --no-progress",
        "test": "phpunit",
        "http-test": "@php tests/http-smoke.php",
        "browser-test": [
            "node tests/browser-alunos-movimentacao.mjs",
            "node tests/browser-password-security.mjs",
            "node tests/browser-contract-tabs.mjs",
            "node tests/browser-passivo-batch.mjs",
            "node tests/browser-report-downloads.mjs"
        ],
        "maintenance": "@php bin/maintenance.php",
        "notify-dva": "@php bin/notify-dva.php",
        "security-check": "@composer audit --locked",
        "check": [
            "@runtime-check",
            "@validate-project",
            "@lint",
            "@analyse",
            "@test",
            "@http-test",
            "@security-check"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
