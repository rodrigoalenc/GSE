# Revise todos os valores antes de implantar. Este arquivo não contém credenciais.
APP_ENV=production
APP_URL=https://gse.escola.example
APP_TIMEZONE=America/Cuiaba
APP_ALLOWED_HOSTS=gse.escola.example
DB_PATH=/var/lib/gse/gse.sqlite
# auto escolhe WAL corrigido ou DELETE; delete permite forçar rollback journal.
DB_JOURNAL_MODE=auto
# Defina apenas se houver proxy reverso; exemplo local: 127.0.0.1,::1
TRUSTED_PROXIES=
FORCE_HTTPS=true
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
SESSION_RENEWAL_INTERVAL=900
LOGIN_PAIR_MAX_ATTEMPTS=5
LOGIN_PAIR_WINDOW_SECONDS=60
LOGIN_ORIGIN_MAX_ATTEMPTS=60
LOGIN_ORIGIN_WINDOW_SECONDS=10
LOGIN_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365
DVA_WARNING_DAYS=30
DVA_EMAIL_WARNING_DAYS=15
MAIL_ENABLED=false
MAIL_HOST=smtp.escola.example
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Use tls para STARTTLS (normalmente 587) ou smtps para TLS implícito (normalmente 465).
# Produção recusa none e combinações incoerentes com as portas padrão.
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=gse@escola.example
MAIL_FROM_NAME=GSE
DB_DIRECTORY_MODE=0700
DB_FILE_MODE=0600
LOG_PATH=/var/log/gse/php_errors.log
CERTIDAO_STORAGE_PATH=/var/lib/gse/certidoes
CERTIDAO_WARNING_DAYS=15
CERTIDAO_PDF_MAX_BYTES=10485760
CERTIDAO_MAIL_ENABLED=false

# Gere em diretório privado fora do projeto e guarde cópia independente.
GSE_KEYRING_PATH=/etc/gse/secrets/keys.json
CONFIRM_MAX_ATTEMPTS=10
CONFIRM_IP_MAX_ATTEMPTS=80
CONFIRM_WINDOW_SECONDS=300
EXPENSIVE_MAX_ATTEMPTS=60
EXPENSIVE_WINDOW_SECONDS=300

# IDs separados por vírgula, concedidos pela escola por função e prazo.
# Exportação também exige health; edição também exige contacts.
ACCESS_HEALTH_STAFF_IDS=
ACCESS_CONTACT_STAFF_IDS=
ACCESS_EXPORT_STAFF_IDS=
ACCESS_MANAGE_STAFF_IDS=
ACCESS_APPROVAL_REFERENCE=
# Data civil AAAA-MM-DD; concessão expirada é negada.
ACCESS_APPROVAL_VALID_UNTIL=
PASSIVO_IMPORT_DIRECTORY=/var/lib/gse/passive-previews
