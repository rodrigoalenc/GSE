# Revise todos os valores antes de implantar. Este arquivo não contém credenciais.
APP_ENV=production
APP_URL=https://gse.escola.example
APP_ALLOWED_HOSTS=gse.escola.example
DB_PATH=/var/lib/gse/gse.sqlite
# Defina apenas se houver proxy reverso; exemplo local: 127.0.0.1,::1
TRUSTED_PROXIES=
FORCE_HTTPS=true
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
SESSION_RENEWAL_INTERVAL=900
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=40
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
LOGIN_DELAY_BASE_MS=200
LOGIN_DELAY_MAX_MS=2000
LOGIN_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365
DB_DIRECTORY_MODE=0700
DB_FILE_MODE=0600
LOG_PATH=/var/log/gse/php_errors.log
