APP_ENV=development
APP_URL=
APP_TIMEZONE=America/Cuiaba
DB_PATH=database/gse.sqlite
APP_ALLOWED_HOSTS=
TRUSTED_PROXIES=
FORCE_HTTPS=false
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
SESSION_RENEWAL_INTERVAL=900
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=40
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
LOGIN_DELAY_BASE_MS=200
LOGIN_DELAY_MAX_MS=2000
LOGIN_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365
DVA_WARNING_DAYS=30
DVA_EMAIL_WARNING_DAYS=15
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls = STARTTLS (normalmente 587); smtps = TLS implícito (normalmente 465).
# none é aceito somente fora de produção para SMTP local de desenvolvimento.
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=GSE
DB_DIRECTORY_MODE=0700
DB_FILE_MODE=0600
LOG_PATH=logs/php_errors.log
