parameters:
    level: 6
    paths:
        - src/Core
        - src/Controllers
        - src/Mail
        - src/Services
        - src/Model/Passivo.php
        - src/Model/Certidao.php
        - src/Model/Contrato.php
        - src/Model/RelatorioAlunos.php
        - src/Model/Aluno.php
        - src/Model/Auditoria.php
        - src/Model/Dva.php
        - src/Model/Painel.php
        - src/Model/Turma.php
        - src/Model/Usuario.php
        - src/Model/Sistema.php
        - bin
    bootstrapFiles:
        - phpstan-bootstrap.php
    tmpDir: .phpstan-cache
    checkMissingCallableSignature: true
    treatPhpDocTypesAsCertain: true
